@using uss.ui.Services.Interface;
@using uss.model;

@inject ICompanyService companyService;

<section class="hero" id="home">

    <div class="hero-grid"></div>

    <div class="container position-relative">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <div class="hero-content">

                    <div class="hero-badge">
                        <i class="bi bi-stars"></i>
                        Building Digital Experiences That Matter
                    </div>

                    <h1>
                        We Build
                        <span class="text-gradient">Software</span>
                        That Moves Businesses Forward.
                    </h1>

                    <p class="hero-description">
                        Unicore Software Solutions is a technology partner for
                        businesses looking to build powerful web applications,
                        mobile apps and custom software that deliver real-world
                        results.
                    </p>

                    <div class="hero-buttons">

                        <a href="#contact" class="btn-primary-custom">
                            Start Your Project
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                        <a href="#services" class="btn-outline-custom">
                            Explore Services
                        </a>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="hero-visual">

                    <div class="orb orb-1"></div>
                    <div class="orb orb-2"></div>


                    <!-- Floating Cards -->

                    <div class="floating-card card-one">

                        <div class="icon">
                            <i class="bi bi-phone"></i>
                        </div>

                        <div>
                            <strong>Mobile Apps</strong>
                            <small>iOS & Android</small>
                        </div>

                    </div>


                    <div class="floating-card card-two">

                        <div class="icon">
                            <i class="bi bi-cloud-check"></i>
                        </div>

                        <div>
                            <strong>Cloud Ready</strong>
                            <small>Scalable Solutions</small>
                        </div>

                    </div>


                    <div class="floating-card card-three">

                        <div class="icon">
                            <i class="bi bi-cpu"></i>
                        </div>

                        <div>
                            <strong>Smart Technology</strong>
                            <small>Modern Architecture</small>
                        </div>

                    </div>


                    <!-- Code Window -->

                    <div class="code-window">

                        <div class="window-header">

                            <span class="window-dot"></span>
                            <span class="window-dot"></span>
                            <span class="window-dot"></span>

                            <span class="window-title">
                                unicore-app.js
                            </span>

                        </div>

                        <div class="code-line">
                            <span class="code-purple">const</span>
                            solution =
                            <span class="code-blue">new</span>
                            Unicore();
                        </div>

                        <div class="code-line">
                            solution.<span class="code-yellow">build</span>({
                        </div>

                        <div class="code-line ps-3">
                            <span class="code-green">innovation</span>:
                            <span class="code-yellow">true</span>,
                        </div>

                        <div class="code-line ps-3">
                            <span class="code-green">scalable</span>:
                            <span class="code-yellow">true</span>,
                        </div>

                        <div class="code-line ps-3">
                            <span class="code-green">secure</span>:
                            <span class="code-yellow">true</span>,
                        </div>

                        <div class="code-line ps-3">
                            <span class="code-green">futureReady</span>:
                            <span class="code-yellow">true</span>
                        </div>

                        <div class="code-line">
                            });
                        </div>

                        <div class="code-line mt-2">
                            <span class="code-purple">return</span>
                            <span class="code-green">"Success 🚀"</span>;
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="scroll-down d-none d-md-block">
        SCROLL TO EXPLORE
        <i class="bi bi-chevron-down"></i>
    </div>

</section>

<section class="client-strip">

    <div class="container">

        <div class="client-text">
            Technologies We Work With
        </div>

        <div class="tech-logos">

            <span>C#.Net</span>
            <span>SQL</span>
            <span>Node.js</span>
            <span>React</span>
            <span>MAUI</span>
            <span>ML.Net</span>
            <span>Python</span>
            <span>Docker</span>

        </div>

    </div>

</section>

@code{
    Company company;
    protected override async Task OnInitializedAsync(){
        company = companyService.Get();
    }
}