            <div class="row align-items-center g-5 position-relative">

                <div class="col-lg-6">

                    <div class="liveapp-content">

                        <div class="liveapp-badge">
                            <span class="liveapp-status-dot"></span>
                            Product Coming Soon
                        </div>

                        <div class="liveapp-label">
                            <i class="bi bi-lightning-charge-fill"></i>
                            Introducing
                        </div>

                        <h2>
                            Live<span class="text-gradient">App</span>
                        </h2>

                        <h3>
                            Play Anything, Instantly.
                        </h3>

                        <p>
                            LiveApp is a platform for discovering and running
                            interactive apps and games without ever installing them.
                        </p>

