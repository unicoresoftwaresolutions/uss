
<section class="section-padding contact-section" id="contact">

    <div class="container">

        <div class="section-title reveal">

            <span class="eyebrow">
                Get In Touch
            </span>

            <h2>
                Let's Discuss
                <span class="text-gradient">Your Project.</span>
            </h2>

            <p>
                Have a project in mind? Send us your requirements and let's
                explore how we can help.
            </p>

        </div>


        <div class="row g-4">

            <!-- Contact Details -->

            <div class="col-lg-5 reveal">

                <div class="contact-info">

                    <h3>Let's Talk.</h3>

                    <p>
                        Whether you're launching a new product, improving an
                        existing system or looking for a technology partner,
                        we're ready to help.
                    </p>


                    <div class="contact-item">

                        <i class="bi bi-envelope"></i>

                        <div>
                            <strong>Email</strong>
                            <span>info@unicoresoftwaresolutions.com</span>
                        </div>

                    </div>


                    <div class="contact-item">

                        <i class="bi bi-telephone"></i>

                        <div>
                            <strong>Phone</strong>
                            <span>+91 82200 20227</span>
                        </div>

                    </div>


                    <div class="contact-item">

                        <i class="bi bi-geo-alt"></i>

                        <div>
                            <strong>Location</strong>
                            <span>India</span>
                        </div>

                    </div>


                    <div class="contact-item">

                        <i class="bi bi-clock"></i>

                        <div>
                            <strong>Working Hours</strong>
                            <span>Monday – Saturday, 9:00 AM – 9:00 PM</span>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Contact Form -->

            <div class="col-lg-7 reveal">

                <div class="contact-form">

                    <form id="contactForm">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Your Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="John Doe"
                                       required>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Email Address
                                </label>

                                <input type="email"
                                       class="form-control"
                                       placeholder="john@example.com"
                                       required>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Phone Number
                                </label>

                                <input type="tel"
                                       class="form-control"
                                       placeholder="+91 00000 00000">

                            </div>


                            <div class="col-md-6">

                                <label class="form-label small fw-semibold">
                                    Service
                                </label>

                                <select class="form-select">

                                    <option selected>
                                        Select a service
                                    </option>

                                    <option>
                                        Web Development
                                    </option>

                                    <option>
                                        Mobile App Development
                                    </option>

                                    <option>
                                        Custom Software
                                    </option>

                                    <option>
                                        UI / UX Design
                                    </option>

                                    <option>
                                        Cloud Solutions
                                    </option>

                                    <option>
                                        AI & Automation
                                    </option>

                                </select>

                            </div>


                            <div class="col-12">

                                <label class="form-label small fw-semibold">
                                    Tell Us About Your Project
                                </label>

                                <textarea class="form-control"
                                          rows="6"
                                          placeholder="Tell us about your idea, requirements or business challenge..."
                                          required></textarea>

                            </div>


                            <div class="col-12">

                                <button type="submit"
                                        class="btn-primary-custom w-100">

                                    Send Enquiry
                                    <i class="bi bi-send ms-2"></i>

                                </button>

                            </div>

                        </div>

                    </form>


                    <div id="formMessage"
                         class="alert alert-success mt-3 d-none">

                        Thank you! Your message has been received.
                        We will get back to you soon.

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>