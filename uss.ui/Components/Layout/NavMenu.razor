@using uss.ui.Services.Interface;
@using uss.model;

@inject ICompanyService companyService;

<nav class="navbar navbar-expand-lg fixed-top" id="mainNavbar">
    <div class="container">

        <a class="navbar-brand" href="#home">
            <div><img src="assets/images/logo.png" title="USS" alt="USS" width="50px" />@company.Name</div>
        </a>

        <button class="navbar-toggler border-0 shadow-none"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
            <i class="bi bi-list fs-2"></i>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link" href="#home">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#about">About</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#services">Services</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#technology">Technology</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#projects">Projects</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#liveapp">LiveApp</a>
                </li>

                <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                    <a class="nav-link nav-cta" href="#contact">
                        Let's Talk <i class="bi bi-arrow-up-right ms-1"></i>
                    </a>
                </li>

            </ul>

        </div>

    </div>
</nav>


@code {
    Company company;
    protected override async Task OnInitializedAsync()
    {
        company = companyService.Get();
    }
}